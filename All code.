package com.spes.chargelimiter;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.Locale;

public final class SysfsController {

    public static final class NodeSpec {
        public final String path;
        public final String enableValue;
        public final String disableValue;

        public NodeSpec(String path, String enableValue, String disableValue) {
            this.path = path;
            this.enableValue = enableValue;
            this.disableValue = disableValue;
        }
    }

    // [ENABLE_VALUE, DISABLE_VALUE]
    private static final NodeSpec[] PRIORITY_NODES = new NodeSpec[] {
        new NodeSpec("/sys/class/power_supply/battery/input_suspend", "0", "1"),
        new NodeSpec("/sys/class/qcom-battery/input_suspend", "0", "1"),
        new NodeSpec("/sys/class/power_supply/battery/charging_enabled", "1", "0"),
        new NodeSpec("/sys/class/power_supply/battery/batt_slate_mode", "0", "1"),
        new NodeSpec("/sys/class/power_supply/usb/input_suspend", "0", "1")
    };

    private static final NodeSpec[] FALLBACK_NODES = new NodeSpec[] {
        new NodeSpec("/sys/class/power_supply/battery/battery_charging_enabled", "1", "0"),
        new NodeSpec("/sys/class/power_supply/battery/charge_disable", "0", "1"),
        new NodeSpec("/sys/class/power_supply/battery/stop_charging", "0", "1"),
        new NodeSpec("/sys/class/power_supply/battery/store_mode", "0", "1"),
        new NodeSpec("/sys/class/power_supply/main/input_suspend", "0", "1")
    };

    private static final String USB_PRESENT_PATH = "/sys/class/power_supply/usb/present";
    private static final String USB_ONLINE_PATH = "/sys/class/power_supply/usb/online";
    private static final String TYPEC_MODE_PATH = "/sys/class/power_supply/usb/typec_mode";

    private static NodeSpec sActiveNode = null;

    private SysfsController() {}

    public static synchronized NodeSpec resolveNode() {
        if (sActiveNode != null) {
            File f = new File(sActiveNode.path);
            if (f.exists() && f.canWrite()) {
                return sActiveNode;
            }
            sActiveNode = null;
        }

        for (int i = 0; i < PRIORITY_NODES.length; i++) {
            NodeSpec spec = PRIORITY_NODES[i];
            File file = new File(spec.path);
            if (file.exists() && file.canWrite()) {
                sActiveNode = spec;
                return sActiveNode;
            }
        }

        for (int i = 0; i < FALLBACK_NODES.length; i++) {
            NodeSpec spec = FALLBACK_NODES[i];
            File file = new File(spec.path);
            if (file.exists() && file.canWrite()) {
                sActiveNode = spec;
                return sActiveNode;
            }
        }

        return null;
    }

    public static synchronized boolean isAvailable() {
        return resolveNode() != null;
    }

    public static synchronized boolean setChargingEnabled(boolean enable) {
        NodeSpec node = resolveNode();
        if (node == null) {
            return false;
        }
        String targetVal = enable ? node.enableValue : node.disableValue;
        String currentVal = readNodeValue(node.path);
        if (targetVal.equals(currentVal)) {
            return true;
        }
        return writeNodeValue(node.path, targetVal);
    }

    public static synchronized boolean forceSetChargingEnabled(boolean enable) {
        NodeSpec node = resolveNode();
        if (node == null) {
            return false;
        }
        String targetVal = enable ? node.enableValue : node.disableValue;
        return writeNodeValue(node.path, targetVal);
    }

    public static synchronized boolean isChargingSuspended() {
        NodeSpec node = resolveNode();
        if (node == null) {
            return false;
        }
        String val = readNodeValue(node.path);
        if (val == null) {
            return false;
        }
        return node.disableValue.equals(val);
    }

    public static synchronized boolean isCablePhysicallyConnected(boolean extraPlugged) {
        if (extraPlugged) {
            return true;
        }
        if (!isChargingSuspended()) {
            return false;
        }
        String usbPresent = readNodeValue(USB_PRESENT_PATH);
        if ("1".equals(usbPresent)) {
            return true;
        }
        String typecMode = readNodeValue(TYPEC_MODE_PATH);
        if (typecMode != null && !typecMode.isEmpty()) {
            if (typecMode.toLowerCase(Locale.US).contains("nothing")) {
                return false;
            }
            return true;
        }
        if ("0".equals(usbPresent)) {
            return false;
        }
        return true;
    }

    private static boolean writeNodeValue(String path, String value) {
        FileOutputStream fos = null;
        try {
            fos = new FileOutputStream(path, false);
            byte[] bytes = value.getBytes(StandardCharsets.US_ASCII);
            fos.write(bytes);
            fos.flush();
            return true;
        } catch (IOException e) {
            return false;
        } finally {
            if (fos != null) {
                try {
                    fos.close();
                } catch (IOException ignored) {}
            }
        }
    }

    private static String readNodeValue(String path) {
        FileInputStream fis = null;
        try {
            File file = new File(path);
            if (!file.exists() || !file.canRead()) {
                return null;
            }
            fis = new FileInputStream(file);
            byte[] buffer = new byte[64];
            int read = fis.read(buffer);
            if (read <= 0) {
                return null;
            }
            return new String(buffer, 0, read, StandardCharsets.US_ASCII).trim();
        } catch (IOException e) {
            return null;
        } finally {
            if (fis != null) {
                try {
                    fis.close();
                } catch (IOException ignored) {}
            }
        }
    }
}
