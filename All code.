    private final class FlatSwitchView extends View {
        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
        private final RectF mRect = new RectF();
        private boolean mChecked = false;

        FlatSwitchView(Activity context) {
            super(context);
            setClickable(false);
        }

        void setChecked(boolean checked) {
            if (mChecked != checked) {
                mChecked = checked;
                invalidate();
            }
        }

        @Override
        protected void onDraw(Canvas canvas) {
            super.onDraw(canvas);
            float w = getWidth();
            float h = getHeight();
            float radius = h / 2f;

            mRect.set(0, 0, w, h);
            mPaint.setStyle(Paint.Style.FILL);
            mPaint.setColor(mChecked ? mColorAccent : mColorTrackInactive);
            canvas.drawRoundRect(mRect, radius, radius, mPaint);

            float pad = dp(4);
            float thumbRadius = (h - pad * 2f) / 2f;
            float cx = mChecked ? (w - pad - thumbRadius) : (pad + thumbRadius);
            float cy = h / 2f;

            mPaint.setColor(mChecked ? mColorOnAccent : mColorTextPrimary);
            canvas.drawCircle(cx, cy, thumbRadius, mPaint);
        }

        @Override
        public boolean onTouchEvent(MotionEvent event) {
            return false;
        }
    }
