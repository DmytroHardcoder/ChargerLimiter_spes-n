package com.spes.chargelimiter;

import android.app.job.JobInfo;
import android.app.job.JobParameters;
import android.app.job.JobScheduler;
import android.app.job.JobService;
import android.content.ComponentName;
import android.content.Context;

public final class ChargeTriggerJobService extends JobService {

    private static final int JOB_ID = 1001;

    public static void scheduleChargingWakeup(Context context) {
        Context appCtx = context.getApplicationContext();
        if (appCtx == null) {
            appCtx = context;
        }
        JobScheduler scheduler = (JobScheduler) appCtx.getSystemService(Context.JOB_SCHEDULER_SERVICE);
        if (scheduler == null) {
            return;
        }
        ComponentName component = new ComponentName(appCtx, ChargeTriggerJobService.class);
        JobInfo jobInfo = new JobInfo.Builder(JOB_ID, component)
                .setRequiresCharging(true)
                .setPersisted(true)
                .build();
        scheduler.schedule(jobInfo);
    }

    @Override
    public boolean onStartJob(JobParameters params) {
        ChargeReceiver.evaluateImmediate(this);
        return false;
    }

    @Override
    public boolean onStopJob(JobParameters params) {
        return true;
    }
}
