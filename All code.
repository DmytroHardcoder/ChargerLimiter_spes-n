package com.spes.chargelimiter;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.SharedPreferences;
import android.os.BatteryManager;

public final class ChargeReceiver extends BroadcastReceiver {

    public static final String PREFS_NAME = "charge_limiter_prefs";
    public static final String KEY_ENABLED = "limit_enabled";
    public static final String KEY_LIMIT = "limit_pct";
    public static final String KEY_DELTA = "limit_delta";
    public static final String KEY_THEME = "ui_theme";
    public static final String KEY_LANG = "ui_lang";
    public static final String KEY_UNPLUG_MODE = "unplug_mode";
    public static final String KEY_KILL_HOURS = "kill_hours";
    public static final String KEY_KILL_MINUTES = "kill_minutes";

    public static final int DEFAULT_LIMIT = 80;
    public static final int MIN_LIMIT = 50;
    public static final int MAX_LIMIT = 100;

    public static final int DEFAULT_DELTA = 10;
    public static final int MIN_DELTA = 1;
    public static final int MAX_DELTA = 15;

    public static final int MIN_RESUME_THRESHOLD = 40;

    public static final int MODE_KILL_TIMER_ANY = 0;
    public static final int MODE_KILL_SCREEN_OFF_TIMER = 1;
    public static final int MODE_KILL_SCREEN_OFF_IMMEDIATE = 2;
    public static final int MODE_STAY_ALIVE_IDLE = 3;

    public static final int DEFAULT_KILL_HOURS = 0;
    public static final int DEFAULT_KILL_MINUTES = 5;

    public interface StateListener {
        void onBatteryStateUpdated(int level, boolean plugged, boolean charging, boolean suspended);
    }

    private static ChargeReceiver sDynamicReceiver = null;
    private static StateListener sListener = null;

    public static void setStateListener(StateListener listener) {
        sListener = listener;
    }

    public static SharedPreferences getPrefs(Context context) {
        Context storageCtx = context.createDeviceProtectedStorageContext();
        return storageCtx.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
    }

    public static int computeResumeThreshold(int limit, int delta) {
        int resume = limit - delta;
        return resume < MIN_RESUME_THRESHOLD ? MIN_RESUME_THRESHOLD : resume;
    }

    public static synchronized void registerDynamicReceiver(Context context) {
        Context appContext = context.getApplicationContext();
        if (appContext == null) {
            appContext = context;
        }
        if (sDynamicReceiver == null) {
            sDynamicReceiver = new ChargeReceiver();
            IntentFilter filter = new IntentFilter();
            filter.addAction(Intent.ACTION_BATTERY_CHANGED);
            filter.addAction(Intent.ACTION_POWER_CONNECTED);
            filter.addAction(Intent.ACTION_POWER_DISCONNECTED);
            appContext.registerReceiver(sDynamicReceiver, filter);
        }
    }

    public static synchronized void unregisterDynamicReceiver(Context context) {
        if (sDynamicReceiver != null) {
            Context appContext = context.getApplicationContext();
            if (appContext == null) {
                appContext = context;
            }
            try {
                appContext.unregisterReceiver(sDynamicReceiver);
            } catch (IllegalArgumentException ignored) {}
            sDynamicReceiver = null;
        }
    }

    public static void evaluateImmediate(Context context) {
        evaluateAndCheckConnected(context, true);
    }

    public static boolean evaluateAndCheckConnected(Context context, boolean forceWrite) {
        Context appContext = context.getApplicationContext();
        if (appContext == null) {
            appContext = context;
        }
        Intent sticky = appContext.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
        if (sticky != null) {
            return processBatteryIntent(appContext, sticky, forceWrite);
        } else {
            handlePhysicalDisconnect(appContext);
            return false;
        }
    }

    private static void handlePhysicalDisconnect(Context context) {
        SysfsController.forceSetChargingEnabled(true);
        unregisterDynamicReceiver(context);
        ChargeTriggerJobService.scheduleChargingWakeup(context);
        ChargeMonitorService.notifyCableDisconnected(context);
    }

    @Override
    public void onReceive(Context context, Intent intent) {
        if (context == null || intent == null) {
            return;
        }
        String action = intent.getAction();
        if (Intent.ACTION_BATTERY_CHANGED.equals(action)) {
            processBatteryIntent(context, intent, false);
        } else if (Intent.ACTION_BOOT_COMPLETED.equals(action)
                || Intent.ACTION_LOCKED_BOOT_COMPLETED.equals(action)
                || Intent.ACTION_POWER_CONNECTED.equals(action)
                || Intent.ACTION_POWER_DISCONNECTED.equals(action)) {
            evaluateImmediate(context);
        }
    }

    private static boolean processBatteryIntent(Context context, Intent batteryIntent, boolean forceWrite) {
        SharedPreferences prefs = getPrefs(context);
        boolean limiterEnabled = prefs.getBoolean(KEY_ENABLED, false);
        int limit = prefs.getInt(KEY_LIMIT, DEFAULT_LIMIT);
        if (limit < MIN_LIMIT) limit = MIN_LIMIT;
        if (limit > MAX_LIMIT) limit = MAX_LIMIT;

        int delta = prefs.getInt(KEY_DELTA, DEFAULT_DELTA);
        if (delta < MIN_DELTA) delta = MIN_DELTA;
        if (delta > MAX_DELTA) delta = MAX_DELTA;

        int resumeThreshold = computeResumeThreshold(limit, delta);

        int level = batteryIntent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
        int scale = batteryIntent.getIntExtra(BatteryManager.EXTRA_SCALE, 100);
        int status = batteryIntent.getIntExtra(BatteryManager.EXTRA_STATUS, BatteryManager.BATTERY_STATUS_UNKNOWN);
        int pluggedInt = batteryIntent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0);

        if (level < 0 || scale <= 0) {
            return false;
        }

        int pct = (level * 100) / scale;
        boolean extraPlugged = pluggedInt != 0;
        boolean cableConnected = SysfsController.isCablePhysicallyConnected(extraPlugged);

        if (!cableConnected) {
            StateListener listener = sListener;
            if (listener != null) {
                listener.onBatteryStateUpdated(pct, false, false, false);
            }
            handlePhysicalDisconnect(context);
            return false;
        }

        registerDynamicReceiver(context);
        ChargeMonitorService.notifyCableConnected(context);

        if (!limiterEnabled) {
            if (forceWrite || SysfsController.isChargingSuspended()) {
                SysfsController.forceSetChargingEnabled(true);
            }
        } else {
            if (pct >= limit) {
                if (forceWrite) {
                    SysfsController.forceSetChargingEnabled(false);
                } else {
                    SysfsController.setChargingEnabled(false);
                }
            } else if (pct <= resumeThreshold) {
                if (forceWrite) {
                    SysfsController.forceSetChargingEnabled(true);
                } else {
                    SysfsController.setChargingEnabled(true);
                }
            }
        }

        boolean suspended = SysfsController.isChargingSuspended();
        boolean isCharging = (status == BatteryManager.BATTERY_STATUS_CHARGING) && !suspended;

        StateListener listener = sListener;
        if (listener != null) {
            listener.onBatteryStateUpdated(pct, true, isCharging, suspended);
        }
        return true;
    }
}
