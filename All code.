### `update-binary`

```sh
#!/sbin/sh
# META-INF/com/google/android/update-binary

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo "ui_print $1" > /proc/self/fd/$OUTFD
    echo "ui_print" > /proc/self/fd/$OUTFD
}

abort() {
    ui_print "$1"
    exit 1
}

ui_print "------------------------------------------"
ui_print " ChargeLimiter System Installer (SM6225)  "
ui_print " Target: Xiaomi Redmi Note 11 (spes/spesn)"
ui_print "------------------------------------------"

SLOT=$(getprop ro.boot.slot_suffix 2>/dev/null)

for MAPPER in /dev/block/mapper/system /dev/block/mapper/system_a /dev/block/mapper/system_b /dev/block/mapper/system$SLOT; do
    if [ -e "$MAPPER" ]; then
        blockdev --setrw "$MAPPER" 2>/dev/null
    fi
done

mount /system_root 2>/dev/null
mount /system 2>/dev/null

mount -o rw,remount /system_root 2>/dev/null
mount -o rw,remount /system 2>/dev/null
mount -o rw,remount / 2>/dev/null

SYS_PATH=""
if [ -d "/system_root/system/priv-app" ]; then
    SYS_PATH="/system_root/system"
elif [ -d "/system/system/priv-app" ]; then
    SYS_PATH="/system/system"
elif [ -d "/system/priv-app" ]; then
    SYS_PATH="/system"
else
    for DEV in "/dev/block/mapper/system$SLOT" "/dev/block/mapper/system" "/dev/block/by-name/system$SLOT" "/dev/block/by-name/system"; do
        if [ -e "$DEV" ]; then
            mkdir -p /mnt/sys_tmp
            mount -t ext4 -o rw "$DEV" /mnt/sys_tmp 2>/dev/null
            if [ -d "/mnt/sys_tmp/system/priv-app" ]; then
                SYS_PATH="/mnt/sys_tmp/system"
                break
            elif [ -d "/mnt/sys_tmp/priv-app" ]; then
                SYS_PATH="/mnt/sys_tmp"
                break
            fi
        fi
    done
fi

[ -z "$SYS_PATH" ] && abort "! Failed to locate writable /system partition"

ui_print "- Mounted system at: $SYS_PATH"

TMP_DIR="/tmp/chargelimiter_install"
rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"

unzip -o "$ZIPFILE" -d "$TMP_DIR" >/dev/null 2>&1 || abort "! Failed to extract package"

APP_DIR="$SYS_PATH/priv-app/ChargeLimiter"
PERM_DIR="$SYS_PATH/etc/permissions"
INIT_DIR="$SYS_PATH/etc/init"

ui_print "- Installing system files..."
mkdir -p "$APP_DIR"
mkdir -p "$PERM_DIR"
mkdir -p "$INIT_DIR"

cp -f "$TMP_DIR/ChargeLimiter.apk" "$APP_DIR/ChargeLimiter.apk" || abort "! Missing ChargeLimiter.apk"
cp -f "$TMP_DIR/privapp-permissions-charge.xml" "$PERM_DIR/privapp-permissions-charge.xml" || abort "! Missing privapp-permissions-charge.xml"
cp -f "$TMP_DIR/init.spes_charge.rc" "$INIT_DIR/init.spes_charge.rc" || abort "! Missing init.spes_charge.rc"

ui_print "- Setting permissions and SELinux contexts..."
chown 0:0 "$APP_DIR"
chmod 0755 "$APP_DIR"

chown 0:0 "$APP_DIR/ChargeLimiter.apk"
chmod 0644 "$APP_DIR/ChargeLimiter.apk"

chown 0:0 "$PERM_DIR/privapp-permissions-charge.xml"
chmod 0644 "$PERM_DIR/privapp-permissions-charge.xml"

chown 0:0 "$INIT_DIR/init.spes_charge.rc"
chmod 0644 "$INIT_DIR/init.spes_charge.rc"

chcon -R u:object_r:system_file:s0 "$APP_DIR" 2>/dev/null
chcon u:object_r:system_file:s0 "$PERM_DIR/privapp-permissions-charge.xml" 2>/dev/null
chcon u:object_r:system_file:s0 "$INIT_DIR/init.spes_charge.rc" 2>/dev/null

rm -rf "$TMP_DIR"
sync

umount /mnt/sys_tmp 2>/dev/null
mount -o ro,remount /system_root 2>/dev/null
mount -o ro,remount /system 2>/dev/null

ui_print "- Installation complete."
exit 0
