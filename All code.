package com.spes.chargelimiter;

import android.app.Service;
import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.SharedPreferences;
import android.os.BatteryManager;
import android.os.Handler;
import android.os.IBinder;
import android.os.Looper;
import android.os.PowerManager;
import android.os.Process;

public final class ChargeMonitorService extends Service {

    private static final long POLL_INTERVAL_MS = 3000L;

    private static final String ACTION_CABLE_CONNECTED = "com.spes.chargelimiter.ACTION_CABLE_CONNECTED";
    private static final String ACTION_CABLE_DISCONNECTED = "com.spes.chargelimiter.ACTION_CABLE_DISCONNECTED";
    private static final String ACTION_RELOAD_UNPLUG_POLICY = "com.spes.chargelimiter.ACTION_RELOAD_UNPLUG_POLICY";

    private static ChargeMonitorService sInstance = null;

    private final Handler mHandler = new Handler(Looper.getMainLooper());
    private boolean mPollingActive = false;
    private boolean mUnplugTimerRunning = false;
    private boolean mUnplugTimerElapsed = false;
    private boolean mScreenReceiverRegistered = false;

    private final Runnable mPollRunnable = new Runnable() {
        @Override
        public void run() {
            if (!mPollingActive) {
                return;
            }
            boolean stillConnected = ChargeReceiver.evaluateAndCheckConnected(ChargeMonitorService.this, false);
            if (stillConnected && mPollingActive) {
                mHandler.postDelayed(this, POLL_INTERVAL_MS);
            }
        }
    };

    private final Runnable mKillTimerRunnable = new Runnable() {
        @Override
        public void run() {
            mUnplugTimerRunning = false;
            mUnplugTimerElapsed = true;
            evaluateKillConditions();
        }
    };

    private final BroadcastReceiver mScreenStateReceiver = new BroadcastReceiver() {
        @Override
        public void onReceive(Context context, Intent intent) {
            if (intent == null) {
                return;
            }
            String action = intent.getAction();
            if (Intent.ACTION_SCREEN_OFF.equals(action) || Intent.ACTION_SCREEN_ON.equals(action)) {
                evaluateKillConditions();
            }
        }
    };

    public static void notifyCableConnected(Context context) {
        ChargeMonitorService inst = sInstance;
        if (inst != null) {
            inst.handleCableConnectedInternal();
            return;
        }
        Context appCtx = context.getApplicationContext();
        if (appCtx == null) {
            appCtx = context;
        }
        try {
            Intent intent = new Intent(appCtx, ChargeMonitorService.class);
            intent.setAction(ACTION_CABLE_CONNECTED);
            appCtx.startService(intent);
        } catch (Throwable ignored) {}
    }

    public static void notifyCableDisconnected(Context context) {
        Context appCtx = context.getApplicationContext();
        if (appCtx == null) {
            appCtx = context;
        }
        SharedPreferences prefs = ChargeReceiver.getPrefs(appCtx);
        int mode = prefs.getInt(ChargeReceiver.KEY_UNPLUG_MODE, ChargeReceiver.MODE_KILL_TIMER_ANY);

        if (mode == ChargeReceiver.MODE_STAY_ALIVE_IDLE) {
            ChargeMonitorService inst = sInstance;
            if (inst != null) {
                inst.cleanupAllAndStopSelf();
            }
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_SCREEN_OFF_IMMEDIATE) {
            if (!isScreenInteractive(appCtx) && !MainActivity.isUiVisible()) {
                ChargeMonitorService inst = sInstance;
                if (inst != null) {
                    inst.cleanupAllAndStopSelf();
                }
                killProcessNow();
                return;
            }
        }

        ChargeMonitorService inst = sInstance;
        if (inst != null) {
            inst.handleCableDisconnectedInternal(false);
            return;
        }
        try {
            Intent intent = new Intent(appCtx, ChargeMonitorService.class);
            intent.setAction(ACTION_CABLE_DISCONNECTED);
            appCtx.startService(intent);
        } catch (Throwable ignored) {}
    }

    public static void notifyPolicyChangedOrUiClosed(Context context, boolean resetTimer) {
        Context appCtx = context.getApplicationContext();
        if (appCtx == null) {
            appCtx = context;
        }
        if (isCableCurrentlyConnected(appCtx)) {
            notifyCableConnected(appCtx);
            return;
        }
        SysfsController.forceSetChargingEnabled(true);
        ChargeReceiver.unregisterDynamicReceiver(appCtx);
        ChargeTriggerJobService.scheduleChargingWakeup(appCtx);

        SharedPreferences prefs = ChargeReceiver.getPrefs(appCtx);
        int mode = prefs.getInt(ChargeReceiver.KEY_UNPLUG_MODE, ChargeReceiver.MODE_KILL_TIMER_ANY);

        if (mode == ChargeReceiver.MODE_STAY_ALIVE_IDLE) {
            ChargeMonitorService inst = sInstance;
            if (inst != null) {
                inst.cleanupAllAndStopSelf();
            }
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_SCREEN_OFF_IMMEDIATE) {
            if (!isScreenInteractive(appCtx) && !MainActivity.isUiVisible()) {
                ChargeMonitorService inst = sInstance;
                if (inst != null) {
                    inst.cleanupAllAndStopSelf();
                }
                killProcessNow();
                return;
            }
        }

        ChargeMonitorService inst = sInstance;
        if (inst != null) {
            inst.handleCableDisconnectedInternal(resetTimer);
            return;
        }
        try {
            Intent intent = new Intent(appCtx, ChargeMonitorService.class);
            intent.setAction(resetTimer ? ACTION_RELOAD_UNPLUG_POLICY : ACTION_CABLE_DISCONNECTED);
            appCtx.startService(intent);
        } catch (Throwable ignored) {}
    }

    @Override
    public void onCreate() {
        super.onCreate();
        sInstance = this;
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        sInstance = this;
        String action = intent != null ? intent.getAction() : null;
        if (ACTION_CABLE_CONNECTED.equals(action)) {
            handleCableConnectedInternal();
        } else if (ACTION_CABLE_DISCONNECTED.equals(action)) {
            handleCableDisconnectedInternal(false);
        } else if (ACTION_RELOAD_UNPLUG_POLICY.equals(action)) {
            handleCableDisconnectedInternal(true);
        } else {
            if (isCableCurrentlyConnected(this)) {
                handleCableConnectedInternal();
            } else {
                handleCableDisconnectedInternal(false);
            }
        }
        return START_STICKY;
    }

    private void handleCableConnectedInternal() {
        cancelUnplugTimersAndReceivers();
        ChargeReceiver.registerDynamicReceiver(this);
        startPolling();
    }

    private void handleCableDisconnectedInternal(boolean forceResetTimer) {
        stopPolling();
        SysfsController.forceSetChargingEnabled(true);
        ChargeReceiver.unregisterDynamicReceiver(this);
        ChargeTriggerJobService.scheduleChargingWakeup(this);

        SharedPreferences prefs = ChargeReceiver.getPrefs(this);
        int mode = prefs.getInt(ChargeReceiver.KEY_UNPLUG_MODE, ChargeReceiver.MODE_KILL_TIMER_ANY);

        if (mode == ChargeReceiver.MODE_STAY_ALIVE_IDLE) {
            cleanupAllAndStopSelf();
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_SCREEN_OFF_IMMEDIATE) {
            mHandler.removeCallbacks(mKillTimerRunnable);
            mUnplugTimerRunning = false;
            mUnplugTimerElapsed = false;
            registerScreenReceiverIfNeeded();
            evaluateKillConditions();
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_TIMER_ANY) {
            unregisterScreenReceiverIfNeeded();
            if (forceResetTimer || (!mUnplugTimerRunning && !mUnplugTimerElapsed)) {
                startUnplugTimer(prefs);
            } else {
                evaluateKillConditions();
            }
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_SCREEN_OFF_TIMER) {
            registerScreenReceiverIfNeeded();
            if (forceResetTimer || (!mUnplugTimerRunning && !mUnplugTimerElapsed)) {
                startUnplugTimer(prefs);
            } else {
                evaluateKillConditions();
            }
        }
    }

    private void startUnplugTimer(SharedPreferences prefs) {
        int hours = prefs.getInt(ChargeReceiver.KEY_KILL_HOURS, ChargeReceiver.DEFAULT_KILL_HOURS);
        int minutes = prefs.getInt(ChargeReceiver.KEY_KILL_MINUTES, ChargeReceiver.DEFAULT_KILL_MINUTES);
        if (hours < 0) hours = 0;
        if (minutes < 0) minutes = 0;
        if (hours == 0 && minutes == 0) {
            minutes = 1;
        }
        long delayMs = ((long) hours * 3600L + (long) minutes * 60L) * 1000L;
        mHandler.removeCallbacks(mKillTimerRunnable);
        mUnplugTimerElapsed = false;
        mUnplugTimerRunning = true;
        mHandler.postDelayed(mKillTimerRunnable, delayMs);
    }

    private void evaluateKillConditions() {
        if (isCableCurrentlyConnected(this)) {
            handleCableConnectedInternal();
            return;
        }

        SharedPreferences prefs = ChargeReceiver.getPrefs(this);
        int mode = prefs.getInt(ChargeReceiver.KEY_UNPLUG_MODE, ChargeReceiver.MODE_KILL_TIMER_ANY);

        if (mode == ChargeReceiver.MODE_STAY_ALIVE_IDLE) {
            cleanupAllAndStopSelf();
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_TIMER_ANY) {
            if (mUnplugTimerElapsed && !MainActivity.isUiVisible()) {
                cleanupAllAndStopSelf();
                killProcessNow();
            }
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_SCREEN_OFF_TIMER) {
            if (mUnplugTimerElapsed && !isScreenInteractive(this) && !MainActivity.isUiVisible()) {
                cleanupAllAndStopSelf();
                killProcessNow();
            }
            return;
        }

        if (mode == ChargeReceiver.MODE_KILL_SCREEN_OFF_IMMEDIATE) {
            if (!isScreenInteractive(this) && !MainActivity.isUiVisible()) {
                cleanupAllAndStopSelf();
                killProcessNow();
            }
        }
    }

    private void startPolling() {
        if (!mPollingActive) {
            mPollingActive = true;
            mHandler.removeCallbacks(mPollRunnable);
            mHandler.postDelayed(mPollRunnable, POLL_INTERVAL_MS);
        }
    }

    private void stopPolling() {
        mPollingActive = false;
        mHandler.removeCallbacks(mPollRunnable);
    }

    private void registerScreenReceiverIfNeeded() {
        if (!mScreenReceiverRegistered) {
            IntentFilter filter = new IntentFilter();
            filter.addAction(Intent.ACTION_SCREEN_OFF);
            filter.addAction(Intent.ACTION_SCREEN_ON);
            registerReceiver(mScreenStateReceiver, filter);
            mScreenReceiverRegistered = true;
        }
    }

    private void unregisterScreenReceiverIfNeeded() {
        if (mScreenReceiverRegistered) {
            try {
                unregisterReceiver(mScreenStateReceiver);
            } catch (IllegalArgumentException ignored) {}
            mScreenReceiverRegistered = false;
        }
    }

    private void cancelUnplugTimersAndReceivers() {
        mHandler.removeCallbacks(mKillTimerRunnable);
        mUnplugTimerRunning = false;
        mUnplugTimerElapsed = false;
        unregisterScreenReceiverIfNeeded();
    }

    private void cleanupAllAndStopSelf() {
        stopPolling();
        cancelUnplugTimersAndReceivers();
        stopSelf();
    }

    private static boolean isCableCurrentlyConnected(Context context) {
        Intent sticky = context.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
        boolean extraPlugged = false;
        if (sticky != null) {
            extraPlugged = sticky.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0;
        }
        return SysfsController.isCablePhysicallyConnected(extraPlugged);
    }

    private static boolean isScreenInteractive(Context context) {
        PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
        return pm != null && pm.isInteractive();
    }

    private static void killProcessNow() {
        Process.killProcess(Process.myPid());
        System.exit(0);
    }

    @Override
    public void onDestroy() {
        stopPolling();
        cancelUnplugTimersAndReceivers();
        if (sInstance == this) {
            sInstance = null;
        }
        super.onDestroy();
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }
}
